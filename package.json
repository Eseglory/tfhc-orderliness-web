{
  "name": "tfhc-orderliness-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev:api": "pnpm --filter @tfhc/api dev",
    "dev:web": "pnpm --filter @tfhc/web dev",
    "build:shared": "pnpm --filter @tfhc/shared build",
    "build:api": "pnpm --filter @tfhc/api build",
    "build:web": "pnpm --filter @tfhc/web build",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @tfhc/api prisma:migrate",
    "db:seed": "pnpm --filter @tfhc/api prisma:seed"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
