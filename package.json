{
  "name": "tfhc-orderliness-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "yarn@4.5.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "yarn workspace @tfhc/api dev",
    "dev:web": "yarn workspace @tfhc/web dev",
    "build:shared": "yarn workspace @tfhc/shared build",
    "build:api": "yarn workspace @tfhc/api build",
    "build:web": "yarn workspace @tfhc/web build",
    "test": "yarn workspaces foreach -A run test",
    "lint": "yarn workspaces foreach -A run lint",
    "db:migrate": "yarn workspace @tfhc/api prisma:migrate",
    "db:seed": "yarn workspace @tfhc/api prisma:seed",
    "test:e2e": "playwright test",
    "setup:admin": "node scripts/bootstrap-admin.cjs",
    "setup:google": "node scripts/configure-web-oauth.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "typescript": "^5.4.0"
  },
  "resolutions": {
    "postcss": "^8.5.23",
    "exceljs/uuid": "^11.1.1"
  }
}
