# Database Connection (e.g. Supabase pooled PostgreSQL URL for Prisma)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:6543/postgres?pgbouncer=true&connection_limit=5"

# Deployment Integrations
# Render deployment trigger (used by scripts/deploy-to-render.cjs & CI/CD)
RENDER_API_KEY=""
RENDER_OWNER_ID="tea-cspppb56l47c73f6skmg"

# Vercel deployment token (optional, for non-interactive Vercel CLI deploys)
VERCEL_TOKEN=""

# Yarn 4 / Corepack
ENABLE_EXPERIMENTAL_COREPACK=1

# Local development ports
PORT=4000
NEXT_PUBLIC_API_URL="http://localhost:4000"
