generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  LEADER
  MEMBER
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  SUSPENDED
  EXEMPT
  NEW_MEMBER
}

enum MeetingStatus {
  SCHEDULED
  ACTIVE
  CLOSED
  CANCELLED
}

enum AttendanceStatus {
  EARLY
  ON_TIME
  GRACE_PERIOD
  LATE
  ABSENT
  EXCUSED
  EXEMPT
}

enum AttendanceMethod {
  SYSTEM_GEO_QR
  SYSTEM_GEO
  MANUAL
  CORRECTION_APPROVED
}

enum ExcuseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApprovedMemberStatus {
  ACTIVE
  REVOKED
}

enum NotificationStatus {
  UNREAD
  READ
}

enum CommunicationChannel {
  PUSH
  EMAIL
  SMS
}

enum CommunicationDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum WeeklyAvailabilityState {
  OPEN
  FINALIZED
  CANCELLED
}

enum ServiceCommitmentStatus {
  COMMITTED
  NOT_COMMITTED
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  googleSubject String? @unique
  role         Role       @default(MEMBER)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  member       Member?
  auditLogs    AuditLog[]
  pushDevices  PushDevice[]

  @@map("users")
}

model SubTeam {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  members     Member[]

  @@map("sub_teams")
}

model Member {
  id                 String              @id @default(uuid())
  userId             String?             @unique
  user               User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  memberCode         String              @unique
  firstName          String
  middleName         String?
  lastName           String
  preferredName      String?
  profilePhotoUrl    String?
  phoneNumber        String
  alternatePhoneNumber String?
  address            String?
  dateOfBirth        DateTime?            @db.Date
  gender             String?
  subTeamId          String?
  subTeam            SubTeam?            @relation(fields: [subTeamId], references: [id], onDelete: SetNull)
  roleInUnit         String              @default("Member")
  dateJoined         DateTime            @default(now())
  status             MemberStatus        @default(ACTIVE)
  attendanceRecords  AttendanceRecord[]
  excuseRequests     AbsenceExcuse[]
  correctionRequests CorrectionRequest[]
  followUpFlags      FollowUpFlag[]
  approvedMember     ApprovedMember?
  notifications      MemberNotification[]
  messages           MemberMessage[]
  celebrations       MemberCelebrationDate[]
  serviceCommitments MemberServiceCommitment[]
  availabilityResponses WeeklyAvailabilityResponse[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([status])
  @@index([subTeamId])
  @@index([status, subTeamId])
  @@map("members")
}

model ApprovedMember {
  id              String               @id @default(uuid())
  email           String
  normalizedEmail String               @unique
  status          ApprovedMemberStatus @default(ACTIVE)
  source          String               @default("MANUAL")
  importedAt      DateTime?
  importedBy      String?
  memberId        String?              @unique
  member          Member?              @relation(fields: [memberId], references: [id], onDelete: SetNull)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([status])
  @@map("approved_members")
}

model MeetingCategory {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  basePoints  Float     @default(10)
  pointWeight Float     @default(1.0)
  meetings    Meeting[]

  @@map("meeting_categories")
}

model Meeting {
  id                   String              @id @default(uuid())
  title                String
  categoryId           String
  category             MeetingCategory     @relation(fields: [categoryId], references: [id])
  meetingDate          DateTime
  startTime            DateTime
  expectedArrivalTime  DateTime
  attendanceOpenTime   DateTime
  gracePeriodMinutes   Int                 @default(10)
  attendanceCloseTime  DateTime
  endTime              DateTime?
  locationName         String
  latitude             Float
  longitude            Float
  geofenceRadiusMeters Float               @default(100.0)
  status               MeetingStatus       @default(SCHEDULED)
  isCompulsory         Boolean             @default(true)
  pointWeight          Float               @default(1.0)
  qrSecret             String?
  attendanceRecords    AttendanceRecord[]
  excuseRequests       AbsenceExcuse[]
  correctionRequests   CorrectionRequest[]
  meetingSummary       MeetingSummary?
  serviceCommitments   MemberServiceCommitment[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([status])
  @@index([startTime])
  @@index([status, attendanceOpenTime, attendanceCloseTime])
  @@map("meetings")
}

model WeeklyAvailabilityCycle {
  id          String                  @id @default(uuid())
  weekStart   DateTime                @unique @db.Date
  opensAt     DateTime
  closesAt    DateTime
  state       WeeklyAvailabilityState @default(OPEN)
  finalizedAt DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  commitments MemberServiceCommitment[]
  responses   WeeklyAvailabilityResponse[]

  @@index([state, closesAt])
  @@map("weekly_availability_cycles")
}

model MemberServiceCommitment {
  id        String                  @id @default(uuid())
  cycleId   String
  cycle     WeeklyAvailabilityCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member                  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  meetingId String
  meeting   Meeting                  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  status    ServiceCommitmentStatus
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  @@unique([cycleId, memberId, meetingId])
  @@index([cycleId, meetingId, status])
  @@map("member_service_commitments")
}

model WeeklyAvailabilityResponse {
  id        String                  @id @default(uuid())
  cycleId   String
  cycle     WeeklyAvailabilityCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member                  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  submittedAt DateTime              @default(now())
  updatedAt DateTime                @updatedAt

  @@unique([cycleId, memberId])
  @@index([cycleId])
  @@map("weekly_availability_responses")
}

model AttendanceRecord {
  id                  String           @id @default(uuid())
  memberId            String
  member              Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  meetingId           String
  meeting             Meeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  expectedArrivalTime DateTime
  actualArrivalTime   DateTime?
  status              AttendanceStatus
  gpsLat              Float?
  gpsLong             Float?
  gpsAccuracy         Float?
  distanceFromVenue   Float?
  method              AttendanceMethod @default(SYSTEM_GEO_QR)
  pointsEarned        Float            @default(0)
  deviceInfo          String?
  isModified          Boolean          @default(false)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([memberId, meetingId])
  @@index([memberId])
  @@index([meetingId])
  @@index([status])
  @@index([memberId, status])
  @@index([actualArrivalTime])
  @@map("attendance_records")
}

model AbsenceExcuse {
  id         String       @id @default(uuid())
  memberId   String
  member     Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  meetingId  String
  meeting    Meeting      @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  reason     String
  category   String
  status     ExcuseStatus @default(PENDING)
  reviewedBy String?
  reviewNote String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([memberId, meetingId])
  @@index([status])
  @@map("absence_excuses")
}

model CorrectionRequest {
  id              String           @id @default(uuid())
  memberId        String
  member          Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  meetingId       String
  meeting         Meeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  requestedStatus AttendanceStatus
  reason          String
  status          ExcuseStatus     @default(PENDING)
  reviewedBy      String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status])
  @@map("correction_requests")
}

model FollowUpFlag {
  id         String   @id @default(uuid())
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  flagLevel  Int
  flagReason String
  isResolved Boolean  @default(false)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isResolved])
  @@index([isResolved, flagLevel])
  @@map("follow_up_flags")
}

model MeetingSummary {
  id               String   @id @default(uuid())
  meetingId        String   @unique
  meeting          Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  expectedCount    Int
  presentCount     Int
  absentCount      Int
  earlyCount       Int
  onTimeCount      Int
  gracePeriodCount Int
  lateCount        Int
  excusedCount     Int
  attendanceRate   Float
  punctualityRate  Float
  createdAt        DateTime @default(now())

  @@map("meeting_summaries")
}

model SystemSetting {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

model PushDevice {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String
  deviceIdentifier String?
  appVersion String?
  lastSeenAt DateTime @default(now())
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("push_devices")
}

model MemberCelebrationDate {
  id          String   @id @default(uuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  type        String
  label       String?
  date        DateTime @db.Date
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([memberId, type])
  @@index([type, isActive])
  @@map("member_celebration_dates")
}

model MemberNotification {
  id        String             @id @default(uuid())
  memberId  String
  member    Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  data      Json?
  status    NotificationStatus @default(UNREAD)
  readAt    DateTime?
  expiresAt DateTime?
  createdAt DateTime           @default(now())
  deliveries CommunicationDelivery[]

  @@index([memberId, status, createdAt])
  @@map("member_notifications")
}

model MemberMessage {
  id        String   @id @default(uuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  subject   String
  body      String
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([memberId, readAt, createdAt])
  @@map("member_messages")
}

model CommunicationDelivery {
  id             String                      @id @default(uuid())
  notificationId String?
  notification   MemberNotification?         @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  channel        CommunicationChannel
  recipient      String
  templateKey    String?
  idempotencyKey String                      @unique
  status         CommunicationDeliveryStatus @default(PENDING)
  provider       String?
  providerRef    String?
  failureReason  String?
  attemptedAt    DateTime?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  @@index([channel, status])
  @@map("communication_deliveries")
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String
  actorUser   User     @relation(fields: [actorUserId], references: [id])
  action      String
  entity      String
  entityId    String
  previousData Json?
  newData     Json?
  reason      String?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([createdAt])
  @@map("audit_logs")
}
