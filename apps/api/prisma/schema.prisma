generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  LEADER
  MEMBER
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  SUSPENDED
  EXEMPT
  NEW_MEMBER
}

enum MeetingStatus {
  SCHEDULED
  ACTIVE
  CLOSED
  CANCELLED
}

enum AttendanceStatus {
  EARLY
  ON_TIME
  GRACE_PERIOD
  LATE
  ABSENT
  EXCUSED
  EXEMPT
}

enum AttendanceMethod {
  SYSTEM_GEO_QR
  SYSTEM_GEO
  MANUAL
  CORRECTION_APPROVED
}

enum ExcuseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApprovedMemberStatus {
  ACTIVE
  REVOKED
}

enum NotificationStatus {
  UNREAD
  READ
}

enum CommunicationChannel {
  PUSH
  EMAIL
  SMS
}

enum CommunicationDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum WeeklyAvailabilityState {
  OPEN
  FINALIZED
  CANCELLED
}

enum EventVisibility {
  PUBLIC
  RESTRICTED
}

enum EventAudienceScope {
  ALL_MEMBERS
  EXECUTIVES
  ADMINS
}

enum EventInvitationStatus {
  INVITED
  ACCEPTED
  DECLINED
  TENTATIVE
  NO_RESPONSE
}

enum ServiceCommitmentStatus {
  COMMITTED
  NOT_COMMITTED
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  googleSubject String? @unique
  role         Role       @default(MEMBER)
  isActive        Boolean   @default(true)
  deactivatedAt   DateTime?
  deactivatedById String?
  invitedById     String?
  invitedAt       DateTime?
  inviteTokenHash String?   @unique
  inviteExpiresAt DateTime?
  inviteAcceptedAt DateTime?
  lastLoginAt     DateTime?
  lastLogoutAt    DateTime?
  // Password auth: staff always have it; members get it when they self-register
  // with email + password (still gated by the ApprovedMember allowlist).
  passwordAuthEnabled Boolean @default(false)
  emailVerifiedAt        DateTime?
  emailVerifyTokenHash  String?   @unique
  emailVerifyExpiresAt  DateTime?
  passwordResetTokenHash String?  @unique
  passwordResetExpiresAt DateTime?
  // Bumped on every password change/reset; tokens issued earlier are rejected.
  passwordChangedAt     DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  member       Member?
  auditLogs    AuditLog[]
  accessRoles  UserAccessRole[]  @relation("UserAccessRoleUser")
  rolesAssigned UserAccessRole[] @relation("UserAccessRoleAssignedBy")
  expensesCreated Expense[]      @relation("ExpenseCreatedBy")

  @@index([isActive])
  @@map("users")
}

model AccessRole {
  id          String                 @id @default(uuid())
  key         String                 @unique
  name        String
  description String?
  isSystem    Boolean                @default(false)
  createdById String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  permissions AccessRolePermission[]
  users       UserAccessRole[]

  @@map("access_roles")
}

model AccessRolePermission {
  id         String     @id @default(uuid())
  roleId     String
  role       AccessRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission String
  createdAt  DateTime   @default(now())

  @@unique([roleId, permission])
  @@index([permission])
  @@map("access_role_permissions")
}

model UserAccessRole {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation("UserAccessRoleUser", fields: [userId], references: [id], onDelete: Cascade)
  roleId       String
  role         AccessRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedById String?
  assignedBy   User?      @relation("UserAccessRoleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  assignedAt   DateTime   @default(now())

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_access_roles")
}

model SubTeam {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  active      Boolean  @default(true)
  members     Member[]
  eventAudiences EventAudience[]

  @@map("sub_teams")
}

model Member {
  eventResponses EventResponse[]
  id                 String              @id @default(uuid())
  userId             String?             @unique
  user               User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  memberCode         String              @unique
  firstName          String
  middleName         String?
  lastName           String
  preferredName      String?
  profilePhotoUrl    String?
  phoneNumber        String
  alternatePhoneNumber String?
  address            String?
  dateOfBirth        DateTime?            @db.Date
  profession         String?
  birthday           String?             // MM-DD; birth year is optional and stored in dateOfBirth
  gender             String?
  subTeamId          String?
  subTeam            SubTeam?            @relation(fields: [subTeamId], references: [id], onDelete: SetNull)
  roleInUnit         String              @default("Member")
  dateJoined         DateTime            @default(now())
  status             MemberStatus        @default(ACTIVE)
  attendanceRecords  AttendanceRecord[]
  excuseRequests     AbsenceExcuse[]
  correctionRequests CorrectionRequest[]
  followUpFlags      FollowUpFlag[]
  approvedMember     ApprovedMember?
  notifications      MemberNotification[]
  messages           MemberMessage[]
  celebrations       MemberCelebrationDate[]
  serviceCommitments MemberServiceCommitment[]
  availabilityResponses WeeklyAvailabilityResponse[]
  eventAudiences     EventAudience[]
  eventInvitations   EventInvitation[]
  approvalRequests   ApprovalRequest[]
  welfareRequests    WelfareRequest[]
  duesAssignments    MemberDuesAssignment[]
  payments           Payment[]
  chatMemberships    ChatRoomMember[]
  chatMessages       ChatMessage[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([status])
  @@index([subTeamId])
  @@index([status, subTeamId])
  @@map("members")
}

model ApprovedMember {
  id              String               @id @default(uuid())
  email           String
  normalizedEmail String               @unique
  status          ApprovedMemberStatus @default(ACTIVE)
  source          String               @default("MANUAL")
  importedAt      DateTime?
  importedBy      String?
  memberId        String?              @unique
  member          Member?              @relation(fields: [memberId], references: [id], onDelete: SetNull)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([status])
  @@map("approved_members")
}

model MeetingCategory {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  basePoints  Float     @default(10)
  pointWeight Float     @default(1.0)
  isSystem    Boolean   @default(false)
  active      Boolean   @default(true)
  meetings    Meeting[]

  @@map("meeting_categories")
}

model EventType {
  id                String    @id @default(uuid())
  key               String    @unique
  name              String
  description       String?
  icon              String?
  color             String?
  defaultCompulsory Boolean   @default(false)
  isSystem          Boolean   @default(false)
  active            Boolean    @default(true)
  sortOrder         Int       @default(100)
  createdById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  meetings          Meeting[]

  @@map("event_types")
}

model EventAudience {
  id           String              @id @default(uuid())
  meetingId    String
  meeting      Meeting             @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  scope        EventAudienceScope?
  memberId     String?
  member       Member?            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  subTeamId    String?
  subTeam      SubTeam?           @relation(fields: [subTeamId], references: [id], onDelete: Cascade)
  createdAt    DateTime            @default(now())

  @@unique([meetingId, scope, memberId, subTeamId])
  @@index([meetingId])
  @@index([memberId])
  @@map("event_audiences")
}

model EventInvitation {
  id        String                @id @default(uuid())
  meetingId String
  meeting   Meeting               @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member               @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status    EventInvitationStatus @default(INVITED)
  respondedAt DateTime?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@unique([meetingId, memberId])
  @@index([memberId, status])
  @@map("event_invitations")
}

model ServiceSchedule {
  id             String   @id
  title          String
  dayOfWeek      Int
  startMinutes   Int
  endMinutes     Int?
  categoryName   String
  enabled        Boolean  @default(true)
  // When set, this rule (RecurrenceRule JSON) drives occurrence generation and
  // dayOfWeek is only the fallback/legacy anchor. Null ⇒ legacy weekly behaviour.
  recurrenceRule Json?
  eventTypeKey   String?
  visibility     EventVisibility @default(PUBLIC)
  horizonDays    Int      @default(28)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  meetings       Meeting[]
  exceptions     ServiceScheduleException[]

  @@map("service_schedules")
}

model ServiceScheduleException {
  id             String          @id @default(uuid())
  scheduleId     String
  schedule       ServiceSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  // The series-computed occurrence start this exception applies to.
  occurrenceStart DateTime
  kind           ServiceExceptionKind
  createdById    String?
  reason         String?
  createdAt      DateTime        @default(now())

  @@unique([scheduleId, occurrenceStart])
  @@index([scheduleId])
  @@map("service_schedule_exceptions")
}

enum ServiceExceptionKind {
  SKIP
  MODIFIED
}

model Meeting {
  description String?
  eventResponses EventResponse[]
  id                   String              @id @default(uuid())
  title                String
  scheduleCancelled    Boolean @default(false)
  serviceScheduleId    String?
  serviceSchedule      ServiceSchedule? @relation(fields: [serviceScheduleId], references: [id], onDelete: SetNull)
  categoryId           String
  category             MeetingCategory     @relation(fields: [categoryId], references: [id])
  eventTypeId          String?
  eventType            EventType?          @relation(fields: [eventTypeId], references: [id], onDelete: SetNull)
  meetingDate          DateTime
  startTime            DateTime
  expectedArrivalTime  DateTime
  attendanceOpenTime   DateTime
  gracePeriodMinutes   Int                 @default(10)
  attendanceCloseTime  DateTime
  endTime              DateTime?
  allDay               Boolean             @default(false)
  locationName         String
  address              String?
  latitude             Float
  longitude            Float
  geofenceRadiusMeters Float               @default(100.0)
  status               MeetingStatus       @default(SCHEDULED)
  cancelReason         String?
  isException          Boolean             @default(false)
  occurrenceStart      DateTime?
  isCompulsory         Boolean             @default(true)
  pointWeight          Float               @default(1.0)
  visibility           EventVisibility     @default(PUBLIC)
  organizerName        String?
  coverImageUrl        String?
  notes                String?
  qrSecret             String?
  archivedAt           DateTime?
  createdById          String?
  attendanceRecords    AttendanceRecord[]
  excuseRequests       AbsenceExcuse[]
  correctionRequests   CorrectionRequest[]
  meetingSummary       MeetingSummary?
  serviceCommitments   MemberServiceCommitment[]
  audiences            EventAudience[]
  invitations          EventInvitation[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([status])
  @@index([startTime])
  @@index([status, attendanceOpenTime, attendanceCloseTime])
  @@index([eventTypeId])
  @@index([visibility, startTime])
  @@unique([serviceScheduleId, startTime])
  @@map("meetings")
}

model WeeklyAvailabilityCycle {
  id          String                  @id @default(uuid())
  weekStart   DateTime                @unique @db.Date
  opensAt     DateTime
  closesAt    DateTime
  state       WeeklyAvailabilityState @default(OPEN)
  finalizedAt DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  commitments MemberServiceCommitment[]
  responses   WeeklyAvailabilityResponse[]

  @@index([state, closesAt])
  @@map("weekly_availability_cycles")
}

model MemberServiceCommitment {
  id        String                  @id @default(uuid())
  cycleId   String
  cycle     WeeklyAvailabilityCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member                  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  meetingId String
  meeting   Meeting                  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  status    ServiceCommitmentStatus
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  @@unique([cycleId, memberId, meetingId])
  @@index([cycleId, meetingId, status])
  @@map("member_service_commitments")
}

model WeeklyAvailabilityResponse {
  id        String                  @id @default(uuid())
  cycleId   String
  cycle     WeeklyAvailabilityCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member                  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  submittedAt DateTime              @default(now())
  updatedAt DateTime                @updatedAt

  @@unique([cycleId, memberId])
  @@index([cycleId])
  @@map("weekly_availability_responses")
}

model AttendanceRecord {
  id                  String           @id @default(uuid())
  memberId            String
  member              Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  meetingId           String
  meeting             Meeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  expectedArrivalTime DateTime
  actualArrivalTime   DateTime?
  status              AttendanceStatus
  gpsLat              Float?
  gpsLong             Float?
  gpsAccuracy         Float?
  distanceFromVenue   Float?
  method              AttendanceMethod @default(SYSTEM_GEO_QR)
  pointsEarned        Float            @default(0)
  deviceInfo          String?
  isModified          Boolean          @default(false)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([memberId, meetingId])
  @@index([memberId])
  @@index([meetingId])
  @@index([status])
  @@index([memberId, status])
  @@index([actualArrivalTime])
  @@map("attendance_records")
}

model AbsenceExcuse {
  id                String       @id @default(uuid())
  memberId          String
  member            Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  meetingId         String
  meeting           Meeting      @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  reason            String
  category          String
  status            ExcuseStatus @default(PENDING)
  reviewedBy        String?
  reviewNote        String?
  approvalRequestId String?      @unique
  approvalRequest   ApprovalRequest? @relation(fields: [approvalRequestId], references: [id], onDelete: SetNull)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([memberId, meetingId])
  @@index([status])
  @@map("absence_excuses")
}

// ---------------------------------------------------------------------------
// Reusable multi-level approval engine
// ---------------------------------------------------------------------------

enum ApprovalRequestType {
  ABSENCE
  WELFARE_FUND
  EXPENSE
  DUES_ADJUSTMENT
  GENERIC
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

enum ApproverMode {
  ROLE
  SPECIFIC_USER
  ANY_WITH_PERMISSION
}

model ApprovalWorkflow {
  id          String              @id @default(uuid())
  key         String              @unique
  name        String
  description String?
  requestType ApprovalRequestType
  active      Boolean             @default(true)
  isSystem    Boolean             @default(false)
  createdById String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  steps       ApprovalStep[]
  requests    ApprovalRequest[]

  @@index([requestType, active])
  @@map("approval_workflows")
}

model ApprovalStep {
  id           String           @id @default(uuid())
  workflowId   String
  workflow     ApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  order        Int
  name         String
  approverMode ApproverMode
  roleKey      String?
  approverUserId String?
  permission   String?
  createdAt    DateTime         @default(now())

  @@unique([workflowId, order])
  @@index([workflowId])
  @@map("approval_steps")
}

model ApprovalRequest {
  id                  String              @id @default(uuid())
  workflowId          String
  workflow            ApprovalWorkflow    @relation(fields: [workflowId], references: [id])
  requestType         ApprovalRequestType
  entityType          String
  entityId            String
  requestedByUserId   String?
  requestedByMemberId String?
  requestedByMember   Member?             @relation(fields: [requestedByMemberId], references: [id], onDelete: SetNull)
  summary             String
  amount              Float?
  status              ApprovalStatus      @default(PENDING)
  currentStepOrder    Int                 @default(1)
  decidedAt           DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  actions             ApprovalAction[]
  absenceExcuse       AbsenceExcuse?
  welfareRequest      WelfareRequest?
  expense             Expense?            @relation("ExpenseApproval")

  @@index([status, requestType])
  @@index([entityType, entityId])
  @@index([requestedByMemberId])
  @@map("approval_requests")
}

model ApprovalAction {
  id         String           @id @default(uuid())
  requestId  String
  request    ApprovalRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  stepOrder  Int
  stepName   String
  actorUserId String
  decision   ApprovalDecision
  comment    String?
  createdAt  DateTime         @default(now())

  @@unique([requestId, stepOrder, actorUserId])
  @@index([requestId])
  @@map("approval_actions")
}

model WelfareRequest {
  id                 String          @id @default(uuid())
  requestedByMemberId String
  requestedByMember  Member          @relation(fields: [requestedByMemberId], references: [id], onDelete: Cascade)
  beneficiaryName    String?
  amount             Float
  purpose            String
  description        String?
  supportingDocUrl   String?
  status             ApprovalStatus  @default(PENDING)
  approvalRequestId  String?         @unique
  approvalRequest    ApprovalRequest? @relation(fields: [approvalRequestId], references: [id], onDelete: SetNull)
  decidedAt          DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([status])
  @@index([requestedByMemberId])
  @@map("welfare_requests")
}

model CorrectionRequest {
  id              String           @id @default(uuid())
  memberId        String
  member          Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  meetingId       String
  meeting         Meeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  requestedStatus AttendanceStatus
  reason          String
  status          ExcuseStatus     @default(PENDING)
  reviewedBy      String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status])
  @@map("correction_requests")
}

model FollowUpFlag {
  id         String   @id @default(uuid())
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  flagLevel  Int
  flagReason String
  isResolved Boolean  @default(false)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isResolved])
  @@index([isResolved, flagLevel])
  @@map("follow_up_flags")
}

model MeetingSummary {
  id               String   @id @default(uuid())
  meetingId        String   @unique
  meeting          Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  expectedCount    Int
  presentCount     Int
  absentCount      Int
  earlyCount       Int
  onTimeCount      Int
  gracePeriodCount Int
  lateCount        Int
  excusedCount     Int
  attendanceRate   Float
  punctualityRate  Float
  createdAt        DateTime @default(now())

  @@map("meeting_summaries")
}

model SystemSetting {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}


model MemberCelebrationDate {
  id          String   @id @default(uuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  type        String
  label       String?
  date        DateTime @db.Date
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([memberId, type])
  @@index([type, isActive])
  @@map("member_celebration_dates")
}

model MemberNotification {
  id        String             @id @default(uuid())
  memberId  String
  member    Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  data      Json?
  status    NotificationStatus @default(UNREAD)
  readAt    DateTime?
  expiresAt DateTime?
  createdAt DateTime           @default(now())
  deliveries CommunicationDelivery[]

  @@index([memberId, status, createdAt])
  @@map("member_notifications")
}

model MemberMessage {
  id        String   @id @default(uuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  subject   String
  body      String
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([memberId, readAt, createdAt])
  @@map("member_messages")
}

model CommunicationDelivery {
  id             String                      @id @default(uuid())
  notificationId String?
  notification   MemberNotification?         @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  channel        CommunicationChannel
  recipient      String
  templateKey    String?
  idempotencyKey String                      @unique
  status         CommunicationDeliveryStatus @default(PENDING)
  provider       String?
  providerRef    String?
  failureReason  String?
  attemptedAt    DateTime?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  @@index([channel, status])
  @@map("communication_deliveries")
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String
  actorUser   User     @relation(fields: [actorUserId], references: [id])
  action      String
  entity      String
  entityId    String
  previousData Json?
  newData     Json?
  reason      String?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([createdAt])
  @@map("audit_logs")
}

model EventResponse {
  id String @id @default(uuid())
  memberId String
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  meetingId String
  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  attending Boolean
  updatedAt DateTime @updatedAt
  @@unique([memberId, meetingId])
  @@index([meetingId, attending])
  @@map("event_responses")
}

// ---------------------------------------------------------------------------
// Finance: expenses, monthly dues, payments, payment accounts
// ---------------------------------------------------------------------------

enum ExpenseStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PAID
  CANCELLED
}

enum FinancePaymentMethod {
  CASH
  BANK_TRANSFER
  POS
  CHEQUE
  ONLINE
  OTHER
}

enum DuesPeriodStatus {
  OPEN
  CLOSED
}

enum DuesAssignmentStatus {
  OUTSTANDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  EXEMPT
  WAIVED
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
  REFUNDED
}

enum PaymentPurpose {
  MONTHLY_DUES
  OFFERING
  PLEDGE
  WELFARE_CONTRIBUTION
  OTHER
}

model ExpenseCategory {
  id          String    @id @default(uuid())
  key         String    @unique
  name        String
  description String?
  active      Boolean   @default(true)
  isSystem    Boolean   @default(false)
  expenses    Expense[]

  @@map("expense_categories")
}

model Expense {
  id                String           @id @default(uuid())
  reference         String           @unique
  title             String
  description       String?
  categoryId        String
  category          ExpenseCategory  @relation(fields: [categoryId], references: [id])
  amount            Float
  incurredOn        DateTime         @db.Date
  vendorName        String?
  paymentMethod     FinancePaymentMethod?
  paymentReference  String?
  attachmentUrl     String?
  status            ExpenseStatus    @default(DRAFT)
  approvalRequestId String?          @unique
  approvalRequest   ApprovalRequest? @relation("ExpenseApproval", fields: [approvalRequestId], references: [id], onDelete: SetNull)
  createdByUserId   String
  createdByUser     User             @relation("ExpenseCreatedBy", fields: [createdByUserId], references: [id])
  paidOn            DateTime?
  paidByUserId      String?
  rejectionReason   String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([status])
  @@index([incurredOn])
  @@index([categoryId])
  @@map("expenses")
}

model PaymentAccount {
  id            String   @id @default(uuid())
  bankName      String
  accountName   String
  accountNumber String
  instructions  String?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(100)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("payment_accounts")
}

model DuesPeriod {
  id              String                 @id @default(uuid())
  year            Int
  month           Int
  label           String
  defaultAmount   Float
  dueDate         DateTime               @db.Date
  status          DuesPeriodStatus       @default(OPEN)
  createdByUserId String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  assignments     MemberDuesAssignment[]

  @@unique([year, month])
  @@index([status])
  @@map("dues_periods")
}

model MemberDuesAssignment {
  id           String               @id @default(uuid())
  periodId     String
  period       DuesPeriod           @relation(fields: [periodId], references: [id], onDelete: Cascade)
  memberId     String
  member       Member               @relation(fields: [memberId], references: [id], onDelete: Cascade)
  amountDue    Float
  amountPaid   Float                @default(0)
  status       DuesAssignmentStatus @default(OUTSTANDING)
  note         String?
  adjustments  Json?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  payments     Payment[]

  @@unique([periodId, memberId])
  @@index([memberId, status])
  @@index([status])
  @@map("member_dues_assignments")
}

model Payment {
  id                String                @id @default(uuid())
  reference         String                @unique
  memberId          String
  member            Member                @relation(fields: [memberId], references: [id], onDelete: Cascade)
  purpose           PaymentPurpose
  amount            Float
  method            FinancePaymentMethod
  payerReference    String?
  description       String?
  paidOn            DateTime              @db.Date
  status            PaymentStatus         @default(PENDING)
  duesAssignmentId  String?
  duesAssignment    MemberDuesAssignment? @relation(fields: [duesAssignmentId], references: [id], onDelete: SetNull)
  recordedByUserId  String?
  confirmedByUserId String?
  confirmedAt       DateTime?
  rejectionReason   String?
  metadata          Json?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([memberId, status])
  @@index([status, purpose])
  @@index([duesAssignmentId])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// In-app chat (real-time messaging)
// ---------------------------------------------------------------------------

enum ChatRoomType {
  GENERAL
  EXECUTIVES
  CUSTOM
  DIRECT
}

enum ChatMemberRole {
  MEMBER
  MODERATOR
}

enum ChatMessageType {
  TEXT
  IMAGE
  AUDIO
  SYSTEM
}

model ChatRoom {
  id           String           @id @default(uuid())
  key          String?          @unique
  name         String
  description  String?
  type         ChatRoomType
  imageUrl     String?
  isActive     Boolean          @default(true)
  /// DIRECT rooms: sorted "memberIdA:memberIdB" so the pair is unique.
  directKey    String?          @unique
  createdById  String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  members      ChatRoomMember[]
  messages     ChatMessage[]

  @@index([type, isActive])
  @@map("chat_rooms")
}

model ChatRoomMember {
  id         String         @id @default(uuid())
  roomId     String
  room       ChatRoom       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  memberId   String
  member     Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role       ChatMemberRole @default(MEMBER)
  lastReadAt DateTime?
  mutedUntil DateTime?
  joinedAt   DateTime       @default(now())
  leftAt     DateTime?

  @@unique([roomId, memberId])
  @@index([memberId])
  @@map("chat_room_members")
}

model ChatMessage {
  id             String          @id @default(uuid())
  roomId         String
  room           ChatRoom        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderMemberId String?
  sender         Member?         @relation(fields: [senderMemberId], references: [id], onDelete: SetNull)
  type           ChatMessageType @default(TEXT)
  body           String?
  attachmentUrl  String?
  attachmentMeta Json?
  replyToId      String?
  replyTo        ChatMessage?    @relation("ChatMessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        ChatMessage[]   @relation("ChatMessageReplies")
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime        @default(now())

  @@index([roomId, createdAt])
  @@index([senderMemberId])
  @@map("chat_messages")
}
