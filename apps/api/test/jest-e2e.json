{
  "rootDir": "..",
  "preset": "ts-jest",
  "testEnvironment": "node",
  "watchman": false,
  "setupFiles": [
    "<rootDir>/test/e2e-env.ts"
  ],
  "testMatch": [
    "**/test/**/*.e2e-spec.ts",
    "**/test/admin-team-invite.spec.ts",
    "**/test/member-lookup-invite.spec.ts",
    "**/test/security-authorization.spec.ts",
    "**/test/receipt-upload.spec.ts",
    "**/test/dues-matrix.spec.ts",
    "**/test/finance-redesign.spec.ts",
    "**/test/receipt-upload-optimization.spec.ts",
    "**/test/payment-adjustments-and-disciplinary.spec.ts",
    "**/test/payment-review-and-balance-management.spec.ts",
    "**/test/timetable-e2e.spec.ts",
    "**/test/official-reviewers.spec.ts",
    "**/test/timetable-analytics.spec.ts"
  ],
  "moduleNameMapper": {
    "^@tfhc/shared$": "<rootDir>/../../packages/shared/src"
  },
  "globalSetup": "<rootDir>/test/e2e-seed.ts",
  "workerIdleMemoryLimit": "512MB"
}