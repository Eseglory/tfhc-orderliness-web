DATABASE_URL=postgresql://tfhc_user:tfhc_secure_password_2026@localhost:54399/tfhc_orderliness_db?schema=public
JWT_SECRET=replace-with-a-long-random-secret
PORT=4000
# Comma-separated Google OAuth 2.0 client IDs whose ID tokens this API will
# accept for member sign-in (POST /auth/google/member). Include the "Web
# application" client ID used by apps/web's Google Identity Services button
# (its own env var is apps/web's NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID — the two
# must be the same value) for this web PWA. A REPLACE_-prefixed value is
# ignored, so member sign-in stays disabled (503) until a real ID is set.
GOOGLE_OAUTH_CLIENT_IDS=REPLACE_WITH_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com
TFHC_TIMEZONE=Africa/Lagos
# Comma-separated list of allowed web origins in production, e.g.
# https://tfhc-tracker.onrender.com. Leave unset in local dev to allow all.
CORS_ORIGIN=

# Shared sender for system and administrator emails. Keep password secret.
SMTP_HOST=mail.eglobalicthub.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tfhc-orderliness@eglobalicthub.com
SMTP_PASSWORD=
SMTP_FROM="TFHC Orderliness <tfhc-orderliness@eglobalicthub.com>"
