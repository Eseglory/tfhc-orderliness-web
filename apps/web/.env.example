NEXT_PUBLIC_API_URL=http://localhost:4000
# Google OAuth client of type Web application, with this web app's origins authorized.
# Must match apps/api's GOOGLE_OAUTH_CLIENT_IDS. A REPLACE_-prefixed value is
# treated as unset (the login page shows "not configured" instead of a button).
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=REPLACE_WITH_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com
