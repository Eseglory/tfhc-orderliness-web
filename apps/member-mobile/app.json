{
  "expo": {
    "name": "TFHC Orderliness",
    "slug": "tfhc-orderliness-member",
    "scheme": "tfhc-orderliness",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.eglobalicthub.tfhcorderliness",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Your location is used only when you check in to verify that you are at the meeting venue."
      }
    },
    "android": {
      "package": "org.tfhc.orderliness.member",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-location", "expo-notifications"],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
